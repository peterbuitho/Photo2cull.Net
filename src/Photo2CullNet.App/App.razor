@using System.Threading.Channels
@implements IDisposable

<div class="toolbar">
    <input type="text" placeholder="Folder to scan…" @bind="_rootPath" @bind:event="oninput" disabled="@_scanning" />
    <button @onclick="BrowseFolder" disabled="@_scanning">Browse…</button>
    <select @bind="_scanModeChoice" disabled="@_scanning">
        <option value="Auto">Auto</option>
        <option value="Landscape">Landscape</option>
        <option value="Portrait">Portrait</option>
        <option value="Object">Object</option>
    </select>
    <button @onclick="StartScan" disabled="@(_scanning || string.IsNullOrWhiteSpace(_rootPath))">Scan</button>
    <button @onclick="GroupDuplicates" disabled="@(_scanning || _results.Count == 0)">Group duplicates</button>
    <button @onclick="RunPipeline" disabled="@(_scanning || _results.Count == 0)">Rank now</button>
    <button @onclick="MoveDisqualified" disabled="@(_scanning || _results.Count == 0)">Move disqualified</button>
</div>

<div class="status-line">
    @if (_scanning)
    {
        <span>Scanning… @_processedCount / @_foundCount</span>
    }
    else if (_results.Count > 0)
    {
        <span>@_results.Count photo(s) scored@(_failures.Count > 0 ? $" -- {_failures.Count} failed" : "")</span>
    }
    else
    {
        <span>Enter a folder and click Scan.</span>
    }
</div>

<div class="tabs">
    <button class="@(_viewMode == ViewMode.Flat ? "active" : "")" @onclick="() => _viewMode = ViewMode.Flat">All photos</button>
    <button class="@(_viewMode == ViewMode.Grouped ? "active" : "")" @onclick="() => _viewMode = ViewMode.Grouped">Duplicate groups (@_duplicateGroups.Count)</button>
    <button class="@(_viewMode == ViewMode.Pipeline ? "active" : "")" @onclick="() => _viewMode = ViewMode.Pipeline">Shortlist@(_pipelineResult is { } pr ? $" ({pr.Shortlist.Count})" : "")</button>
</div>

<div class="weights-pane">
    <label>Sharpness <input type="range" min="0" max="1" step="0.05" value="@_weights.Sharpness" @oninput="e => UpdateWeight(w => w with { Sharpness = ParseFloat(e) })" /></label>
    <label>Exposure <input type="range" min="0" max="1" step="0.05" value="@_weights.Exposure" @oninput="e => UpdateWeight(w => w with { Exposure = ParseFloat(e) })" /></label>
    <label>Contrast <input type="range" min="0" max="1" step="0.05" value="@_weights.Contrast" @oninput="e => UpdateWeight(w => w with { Contrast = ParseFloat(e) })" /></label>
    <label>Color <input type="range" min="0" max="1" step="0.05" value="@_weights.Color" @oninput="e => UpdateWeight(w => w with { Color = ParseFloat(e) })" /></label>
    <label>Composition <input type="range" min="0" max="1" step="0.05" value="@_weights.Composition" @oninput="e => UpdateWeight(w => w with { Composition = ParseFloat(e) })" /></label>
    <label>Subject <input type="range" min="0" max="1" step="0.05" value="@_weights.Subject" @oninput="e => UpdateWeight(w => w with { Subject = ParseFloat(e) })" /></label>
    <label>Disqualify scores below
        <input type="number" min="0" step="1" value="@_technicalThreshold" @oninput="e => _technicalThreshold = double.TryParse(e.Value?.ToString(), out var v) ? Math.Max(v, 0) : _technicalThreshold" />
    </label>
    <label>Duplicate/burst threshold (0-64, lower = stricter)
        <input type="number" min="0" max="64" step="1" value="@_groupThreshold" @oninput="e => _groupThreshold = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 64) : _groupThreshold" />
    </label>
    <label>Shortlist size
        <input type="number" min="1" max="100000" step="1" value="@_shortlistSize" @oninput="e => _shortlistSize = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 1, 100_000) : _shortlistSize" />
    </label>
</div>

@if (_viewMode == ViewMode.Pipeline && _pipelineResult is { } pipeline)
{
    <div class="pipeline-summary">
        @pipeline.Total total -&gt; @pipeline.AfterTechnical passed technical filter -&gt; @pipeline.AfterDedupe after dedupe -&gt; top @pipeline.Shortlist.Count shown
    </div>
}

<div class="grid">
    @foreach (var section in VisibleSections())
    {
        @if (section.Heading is { } heading)
        {
            <h4 class="group-heading">@heading</h4>
        }
        @foreach (var index in section.Indices)
        {
            @RenderCard(_results[index])
        }
    }
</div>

@code {
    private enum ViewMode { Flat, Grouped, Pipeline }

    private sealed record Section(string? Heading, List<int> Indices);

    private sealed record PipelineResultView(int Total, int AfterTechnical, int AfterDedupe, List<int> Shortlist);

    private string _rootPath = "";
    private string _scanModeChoice = "Auto";
    private bool _scanning;
    private int _foundCount;
    private int _processedCount;
    private readonly List<PhotoResult> _results = [];
    private readonly Dictionary<string, int> _indexByPath = [];
    private readonly List<(string Path, string Error)> _failures = [];
    private CancellationTokenSource? _scanCts;

    private ViewMode _viewMode = ViewMode.Flat;
    private List<List<string>> _duplicateGroups = [];

    /// <summary>Max dHash Hamming distance (0-64) for two photos to be considered duplicates/burst-mates.</summary>
    private int _groupThreshold = 6;

    private Weights _weights = Weights.Default;

    /// <summary>Score at/below which entries are flagged for the "disqualify" workflow -- matches app.rs's <c>cull_threshold</c> default.</summary>
    private double _technicalThreshold = 32.0;

    /// <summary>How many photos the pipeline's final shortlist keeps -- matches app.rs's <c>pipeline_top_n</c> default.</summary>
    private int _shortlistSize = 150;
    private PipelineResultView? _pipelineResult;

    private const double SharpnessBlurryMax = 40.0;
    private const double SharpnessSoftMax = 100.0;

    private ScanMode CurrentScanMode() => _scanModeChoice switch
    {
        "Landscape" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Landscape),
        "Portrait" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Portrait),
        "Object" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Object),
        _ => Photo2CullNet.Core.ScanMode.Auto,
    };

    private void UpdateWeight(Func<Weights, Weights> update)
    {
        _weights = update(_weights);
        if (_viewMode == ViewMode.Pipeline)
        {
            RunPipeline();
        }
    }

    private static float ParseFloat(Microsoft.AspNetCore.Components.ChangeEventArgs e) =>
        float.TryParse(e.Value?.ToString(), out var v) ? v : 0f;

    private async Task BrowseFolder()
    {
        var picked = await Native.FolderPicker.PickFolderAsync();
        if (picked is not null)
        {
            _rootPath = picked;
        }
    }

    private async Task StartScan()
    {
        if (!Directory.Exists(_rootPath))
        {
            _failures.Clear();
            _failures.Add((_rootPath, "not a folder"));
            return;
        }

        _scanCts?.Cancel();
        _scanCts = new CancellationTokenSource();

        _results.Clear();
        _indexByPath.Clear();
        _failures.Clear();
        _duplicateGroups.Clear();
        _pipelineResult = null;
        _foundCount = 0;
        _processedCount = 0;
        _scanning = true;

        var channel = Channel.CreateUnbounded<ScanEvent>();
        _ = Task.Run(() => Scan.RunScanAsync(_rootPath, CurrentScanMode(), channel.Writer, _scanCts.Token));

        await foreach (var evt in channel.Reader.ReadAllAsync(_scanCts.Token))
        {
            switch (evt)
            {
                case ScanEvent.Found found:
                    _foundCount = found.Count;
                    break;
                case ScanEvent.Photo photo:
                    _indexByPath[photo.Result.Path] = _results.Count;
                    _results.Add(photo.Result);
                    _processedCount++;
                    break;
                case ScanEvent.Failed failed:
                    _failures.Add((failed.Path, failed.Error));
                    _processedCount++;
                    break;
                case ScanEvent.Done:
                    _scanning = false;
                    break;
            }
            StateHasChanged();
        }
    }

    private void GroupDuplicates()
    {
        var hashes = _results.Select(r => (r.Path, r.PHash)).ToList();
        _duplicateGroups = Dedupe.GroupDuplicates(hashes, _groupThreshold);
        _viewMode = ViewMode.Grouped;
    }

    /// <summary>
    /// Technical filter (raw sharpness above the cutoff) -&gt; dedupe
    /// (best-of-group by Overall) -&gt; rank by Overall -&gt; top N. Mirrors
    /// the Rust app's "Rank now" funnel.
    /// </summary>
    private void RunPipeline()
    {
        int total = _results.Count;
        var survivorsIdx = new List<int>();
        for (int i = 0; i < _results.Count; i++)
        {
            if (_results[i].Score > _technicalThreshold) survivorsIdx.Add(i);
        }
        int afterTechnical = survivorsIdx.Count;

        var hashes = survivorsIdx.Select(i => (Path: i.ToString(), Hash: _results[i].PHash)).ToList();
        var groups = Dedupe.GroupDuplicates(hashes, _groupThreshold);
        var grouped = new HashSet<int>(groups.SelectMany(g => g.Select(int.Parse)));

        var bestOfGroup = new List<int>();
        foreach (var group in groups)
        {
            var indices = group.Select(int.Parse);
            bestOfGroup.Add(indices.OrderByDescending(i => Ranking.OverallScore(_results[i].Metrics, _weights)).First());
        }
        var ungrouped = survivorsIdx.Where(i => !grouped.Contains(i));
        var afterDedupeIdx = bestOfGroup.Concat(ungrouped).ToList();

        var shortlist = afterDedupeIdx
            .OrderByDescending(i => Ranking.OverallScore(_results[i].Metrics, _weights))
            .Take(_shortlistSize)
            .ToList();

        _pipelineResult = new PipelineResultView(total, afterTechnical, afterDedupeIdx.Count, shortlist);
        _viewMode = ViewMode.Pipeline;
    }

    /// <summary>Moves photos at or below the technical cutoff into the disqualified subfolder.</summary>
    private void MoveDisqualified()
    {
        var dir = Path.Combine(_rootPath, Scan.DisqualifiedDir);
        Directory.CreateDirectory(dir);

        foreach (var result in _results.Where(r => r.Score <= _technicalThreshold).ToList())
        {
            try
            {
                var dest = Path.Combine(dir, Path.GetFileName(result.Path));
                File.Move(result.Path, dest, overwrite: false);
                if (_indexByPath.TryGetValue(result.Path, out var idx))
                {
                    _results.RemoveAt(idx);
                    RebuildIndex();
                }
            }
            catch (Exception e)
            {
                _failures.Add((result.Path, e.Message));
            }
        }
    }

    private void RebuildIndex()
    {
        _indexByPath.Clear();
        for (int i = 0; i < _results.Count; i++) _indexByPath[_results[i].Path] = i;
    }

    private IEnumerable<Section> VisibleSections()
    {
        switch (_viewMode)
        {
            case ViewMode.Grouped:
                foreach (var group in _duplicateGroups)
                {
                    var indices = group.Where(_indexByPath.ContainsKey).Select(p => _indexByPath[p]).ToList();
                    yield return new Section($"Group ({indices.Count})", indices);
                }
                break;
            case ViewMode.Pipeline:
                if (_pipelineResult is { } pr)
                {
                    yield return new Section(null, pr.Shortlist);
                }
                break;
            default:
                yield return new Section(null, Enumerable.Range(0, _results.Count)
                    .OrderByDescending(i => _results[i].Score).ToList());
                break;
        }
    }

    private async Task OnModeChanged(int index, ChangeEventArgs e)
    {
        if (!Enum.TryParse<PhotoMode>(e.Value?.ToString(), out var mode)) return;

        var old = _results[index];
        var channel = Channel.CreateUnbounded<RecomputeEvent>();
        var items = new List<(string Path, PhotoMode Mode)> { (old.Path, mode) };
        _ = Task.Run(() => Scan.RunRecomputeAsync(items, channel.Writer));

        await foreach (var evt in channel.Reader.ReadAllAsync())
        {
            if (evt is RecomputeEvent.Result r && _indexByPath.TryGetValue(r.Value.Path, out var idx))
            {
                var current = _results[idx];
                _results[idx] = current with { Mode = mode, Score = r.Value.Score, Metrics = r.Value.Metrics };
                StateHasChanged();
            }
        }
    }

    private RenderFragment RenderCard(PhotoResult result) => @<div class="card">
        <div class="thumb-box">
            <img src="@ThumbDataUri(result)" alt="" />
        </div>
        <div class="info">
            <div class="filename">@Path.GetFileName(result.Path)</div>
            <select value="@result.Mode" @onchange="e => OnModeChanged(_indexByPath[result.Path], e)">
                @foreach (var m in PhotoModeExtensions.All)
                {
                    <option value="@m">@m.Label()</option>
                }
            </select>
            <span class="badge @SharpnessBadgeClass(result.Score)">@result.Score.ToString("0.0")</span>
            <span class="overall">Overall: @Ranking.OverallScore(result.Metrics, _weights).ToString("0.0")</span>
        </div>
    </div>;

    private static string SharpnessBadgeClass(double raw) =>
        raw <= SharpnessBlurryMax ? "badge-blurry" : raw <= SharpnessSoftMax ? "badge-soft" : "badge-sharp";

    private readonly Dictionary<string, string> _thumbCache = [];

    private string ThumbDataUri(PhotoResult result)
    {
        if (_thumbCache.TryGetValue(result.Path, out var cached)) return cached;
        var base64 = Convert.ToBase64String(result.EncodeThumbPng());
        var uri = $"data:image/png;base64,{base64}";
        _thumbCache[result.Path] = uri;
        return uri;
    }

    public void Dispose() => _scanCts?.Cancel();
}
