@using System.Diagnostics
@using System.Globalization
@using System.Threading.Channels
@implements IDisposable

<div class="toolbar">
    <input type="text" placeholder="Folder to scan…" @bind="_rootPath" @bind:event="oninput" disabled="@_scanning" />
    <button @onclick="BrowseFolder" disabled="@_scanning">Browse…</button>
    <select @bind="_scanModeChoice" disabled="@_scanning">
        <option value="Auto">Auto</option>
        <option value="Landscape">Landscape</option>
        <option value="Portrait">Portrait</option>
        <option value="Object">Object</option>
    </select>
    <button class="primary" @onclick="StartScan" disabled="@(_scanning || string.IsNullOrWhiteSpace(_rootPath))">Scan</button>
    <button @onclick="GroupDuplicates" disabled="@(_scanning || _results.Count == 0)">Group duplicates</button>
    <button @onclick="RunPipeline" disabled="@(_scanning || _results.Count == 0)">Rank now</button>
    <button @onclick="MoveDisqualified" disabled="@(_scanning || _results.Count == 0)">Move disqualified</button>
</div>

<div class="status-line">
    @if (_scanning)
    {
        <span>Scanning… @_processedCount / @_foundCount</span>
    }
    else if (_results.Count > 0)
    {
        <span>@_results.Count photo(s) scored@(_failures.Count > 0 ? $" -- {_failures.Count} failed" : "")</span>
    }
    else
    {
        <span>Enter a folder and click Scan.</span>
    }
</div>

<div class="tabs">
    <button class="@(_viewMode == ViewMode.Flat ? "active" : "")" @onclick="() => _viewMode = ViewMode.Flat">All photos</button>
    <button class="@(_viewMode == ViewMode.Grouped ? "active" : "")" @onclick="() => _viewMode = ViewMode.Grouped">Duplicate groups (@_duplicateGroups.Count)</button>
    <button class="@(_viewMode == ViewMode.Pipeline ? "active" : "")" @onclick="() => _viewMode = ViewMode.Pipeline">Shortlist@(_pipelineResult is { } pr ? $" ({pr.Shortlist.Count})" : "")</button>
    <label class="sort-by">Sort by
        <select value="@_sortBy" @onchange="OnSortByChanged">
            <option value="Sharpness">Sharpness</option>
            <option value="Overall">Overall</option>
        </select>
    </label>
</div>

<div class="weights-pane">
    <label>Sharpness <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Sharpness)" @oninput="e => UpdateWeight(w => w with { Sharpness = ParseFloat(e) })" /></label>
    <label>Exposure <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Exposure)" @oninput="e => UpdateWeight(w => w with { Exposure = ParseFloat(e) })" /></label>
    <label>Contrast <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Contrast)" @oninput="e => UpdateWeight(w => w with { Contrast = ParseFloat(e) })" /></label>
    <label>Color <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Color)" @oninput="e => UpdateWeight(w => w with { Color = ParseFloat(e) })" /></label>
    <label>Composition <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Composition)" @oninput="e => UpdateWeight(w => w with { Composition = ParseFloat(e) })" /></label>
    <label>Subject <input type="range" min="0" max="1" step="0.05" value="@F(_weights.Subject)" @oninput="e => UpdateWeight(w => w with { Subject = ParseFloat(e) })" /></label>
    <label>Disqualify scores below
        <input type="number" min="0" step="1" value="@F(_technicalThreshold)" @oninput="e => _technicalThreshold = ParseDouble(e, _technicalThreshold, min: 0)" />
    </label>
    <label>Duplicate/burst threshold (0-64, lower = stricter)
        <input type="number" min="0" max="64" step="1" value="@_groupThreshold" @oninput="e => _groupThreshold = ParseInt(e, _groupThreshold, 0, 64)" />
    </label>
    <label>Shortlist size
        <input type="number" min="1" max="100000" step="1" value="@_shortlistSize" @oninput="e => _shortlistSize = ParseInt(e, _shortlistSize, 1, 100_000)" />
    </label>
</div>

@if (_viewerPath is { } viewerPath)
{
    <div class="viewer-overlay" @onclick="CloseViewer" @onkeydown="OnViewerKeyDown" tabindex="0" @ref="_viewerOverlayRef">
        <div class="viewer-content" @onclick:stopPropagation="true">
            <div class="viewer-header">
                <span>@Path.GetFileName(viewerPath)</span>
                <button @onclick="CloseViewer">Close (Esc)</button>
            </div>
            @if (_viewerDataUri is { } uri)
            {
                <img class="viewer-image" src="@uri" alt="" />
            }
            else
            {
                <div class="viewer-loading">Loading full size…</div>
            }
        </div>
    </div>
}

@if (_viewMode == ViewMode.Pipeline && _pipelineResult is { } pipeline)
{
    <div class="pipeline-summary">
        @pipeline.Total total -&gt; @pipeline.AfterTechnical passed technical filter -&gt; @pipeline.AfterDedupe after dedupe -&gt; top @pipeline.Shortlist.Count shown
    </div>
}

<div class="grid">
    @foreach (var section in VisibleSections())
    {
        @if (section.Heading is { } heading)
        {
            <h4 class="group-heading">@heading</h4>
        }
        @foreach (var index in section.Indices)
        {
            var result = _results[index];
            <div class="card" @key="result.Path">
                <div class="thumb-box">
                    <img src="@ThumbDataUri(result)" alt="" title="Double-click for full size" @ondblclick="() => OpenPreview(result.Path)" />
                </div>
                <div class="info">
                    <div class="filename">@Path.GetFileName(result.Path)</div>
                    <select value="@result.Mode" @onchange="e => OnModeChanged(_indexByPath[result.Path], e)">
                        @foreach (var m in PhotoModeExtensions.All)
                        {
                            <option value="@m">@m.Label()</option>
                        }
                    </select>
                    <span class="badge @SharpnessBadgeClass(result.Score)">@result.Score.ToString("0.0")</span>
                    <span class="overall">Overall: @Ranking.OverallScore(result.Metrics, _weights).ToString("0.0")</span>
                </div>
            </div>
        }
    }
</div>

@code {
    private enum ViewMode { Flat, Grouped, Pipeline }

    /// <summary>
    /// Which score the Flat grid is sorted by. Mirrors app.rs's `SortBy`:
    /// this only changes display order -- the disqualify/pipeline/dedupe
    /// logic always operates on raw sharpness regardless of this setting.
    /// </summary>
    private enum SortBy { Sharpness, Overall }

    private sealed record Section(string? Heading, List<int> Indices);

    private sealed record PipelineResultView(int Total, int AfterTechnical, int AfterDedupe, List<int> Shortlist);

    private string _rootPath = "";
    private string _scanModeChoice = "Auto";
    private bool _scanning;
    private int _foundCount;
    private int _processedCount;
    private readonly List<PhotoResult> _results = [];
    private readonly Dictionary<string, int> _indexByPath = [];
    private readonly List<(string Path, string Error)> _failures = [];
    private CancellationTokenSource? _scanCts;

    private ViewMode _viewMode = ViewMode.Flat;
    private SortBy _sortBy = SortBy.Sharpness;
    private List<List<string>> _duplicateGroups = [];

    /// <summary>Max dHash Hamming distance (0-64) for two photos to be considered duplicates/burst-mates.</summary>
    private int _groupThreshold = 6;

    private Weights _weights = Weights.Default;

    /// <summary>Score at/below which entries are flagged for the "disqualify" workflow -- matches app.rs's <c>cull_threshold</c> default.</summary>
    private double _technicalThreshold = 32.0;

    /// <summary>How many photos the pipeline's final shortlist keeps -- matches app.rs's <c>pipeline_top_n</c> default.</summary>
    private int _shortlistSize = 150;
    private PipelineResultView? _pipelineResult;

    private const double SharpnessBlurryMax = 40.0;
    private const double SharpnessSoftMax = 100.0;

    private ScanMode CurrentScanMode() => _scanModeChoice switch
    {
        "Landscape" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Landscape),
        "Portrait" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Portrait),
        "Object" => Photo2CullNet.Core.ScanMode.ForMode(PhotoMode.Object),
        _ => Photo2CullNet.Core.ScanMode.Auto,
    };

    private void UpdateWeight(Func<Weights, Weights> update)
    {
        _weights = update(_weights);
        _flatOrderDirty = true; // Overall-sorted order depends on the weights too.
        if (_viewMode == ViewMode.Pipeline)
        {
            RunPipeline();
        }
    }

    private void OnSortByChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortBy>(e.Value?.ToString(), out var sortBy))
        {
            _sortBy = sortBy;
            _flatOrderDirty = true;
        }
    }

    // HTML5 number/range inputs are always period-decimal regardless of OS
    // locale, but plain string interpolation of a float/double formats
    // with the *current* culture -- under a comma-decimal culture that
    // produces e.g. "0,25", which the input rejects as invalid and shows
    // as 0. Format and parse with InvariantCulture explicitly everywhere
    // a number crosses this boundary.
    private static string F(double v) => v.ToString(CultureInfo.InvariantCulture);
    private static string F(float v) => v.ToString(CultureInfo.InvariantCulture);

    private static float ParseFloat(ChangeEventArgs e) =>
        float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0f;

    private static double ParseDouble(ChangeEventArgs e, double fallback, double min) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Max(v, min) : fallback;

    private static int ParseInt(ChangeEventArgs e, int fallback, int min, int max) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v, min, max) : fallback;

    private async Task BrowseFolder()
    {
        var picked = await Native.FolderPicker.PickFolderAsync();
        if (picked is not null)
        {
            _rootPath = picked;
        }
    }

    private async Task StartScan()
    {
        if (!Directory.Exists(_rootPath))
        {
            _failures.Clear();
            _failures.Add((_rootPath, "not a folder"));
            return;
        }

        _scanCts?.Cancel();
        _scanCts = new CancellationTokenSource();

        _results.Clear();
        _indexByPath.Clear();
        _failures.Clear();
        _duplicateGroups.Clear();
        _pipelineResult = null;
        _foundCount = 0;
        _processedCount = 0;
        _scanning = true;
        _flatOrderDirty = true;

        var channel = Channel.CreateUnbounded<ScanEvent>();
        _ = Task.Run(() => Scan.RunScanAsync(_rootPath, CurrentScanMode(), channel.Writer, _scanCts.Token));

        // Re-rendering the whole grid is O(n) in how many photos have
        // landed so far -- doing that after every single photo (rather
        // than batching arrivals between renders) turns an n-photo scan
        // into an O(n^2) render loop, which for 1000+ photos looks
        // indistinguishable from a hang even though the background scan
        // itself is still running fine. Render at most a few times a
        // second instead.
        var renderThrottle = Stopwatch.StartNew();
        await foreach (var evt in channel.Reader.ReadAllAsync(_scanCts.Token))
        {
            bool renderNow = false;
            switch (evt)
            {
                case ScanEvent.Found found:
                    _foundCount = found.Count;
                    renderNow = true;
                    break;
                case ScanEvent.Photo photo:
                    _indexByPath[photo.Result.Path] = _results.Count;
                    _results.Add(photo.Result);
                    _processedCount++;
                    _flatOrderDirty = true;
                    renderNow = renderThrottle.ElapsedMilliseconds > 150;
                    break;
                case ScanEvent.Failed failed:
                    _failures.Add((failed.Path, failed.Error));
                    _processedCount++;
                    break;
                case ScanEvent.Done:
                    _scanning = false;
                    renderNow = true;
                    break;
            }
            if (renderNow)
            {
                StateHasChanged();
                renderThrottle.Restart();
            }
        }

        // Catch anything added since the last throttled render.
        StateHasChanged();
    }

    private void GroupDuplicates()
    {
        var hashes = _results.Select(r => (r.Path, r.PHash)).ToList();
        _duplicateGroups = Dedupe.GroupDuplicates(hashes, _groupThreshold);
        _viewMode = ViewMode.Grouped;
    }

    /// <summary>
    /// Technical filter (raw sharpness above the cutoff) -&gt; dedupe
    /// (best-of-group by Overall) -&gt; rank by Overall -&gt; top N. Mirrors
    /// the Rust app's "Rank now" funnel.
    /// </summary>
    private void RunPipeline()
    {
        int total = _results.Count;
        var survivorsIdx = new List<int>();
        for (int i = 0; i < _results.Count; i++)
        {
            if (_results[i].Score > _technicalThreshold) survivorsIdx.Add(i);
        }
        int afterTechnical = survivorsIdx.Count;

        var hashes = survivorsIdx.Select(i => (Path: i.ToString(), Hash: _results[i].PHash)).ToList();
        var groups = Dedupe.GroupDuplicates(hashes, _groupThreshold);
        var grouped = new HashSet<int>(groups.SelectMany(g => g.Select(int.Parse)));

        var bestOfGroup = new List<int>();
        foreach (var group in groups)
        {
            var indices = group.Select(int.Parse);
            bestOfGroup.Add(indices.OrderByDescending(i => Ranking.OverallScore(_results[i].Metrics, _weights)).First());
        }
        var ungrouped = survivorsIdx.Where(i => !grouped.Contains(i));
        var afterDedupeIdx = bestOfGroup.Concat(ungrouped).ToList();

        var shortlist = afterDedupeIdx
            .OrderByDescending(i => Ranking.OverallScore(_results[i].Metrics, _weights))
            .Take(_shortlistSize)
            .ToList();

        _pipelineResult = new PipelineResultView(total, afterTechnical, afterDedupeIdx.Count, shortlist);
        _viewMode = ViewMode.Pipeline;
    }

    /// <summary>Moves photos at or below the technical cutoff into the disqualified subfolder.</summary>
    private void MoveDisqualified()
    {
        var dir = Path.Combine(_rootPath, Scan.DisqualifiedDir);
        Directory.CreateDirectory(dir);

        foreach (var result in _results.Where(r => r.Score <= _technicalThreshold).ToList())
        {
            try
            {
                var dest = Path.Combine(dir, Path.GetFileName(result.Path));
                File.Move(result.Path, dest, overwrite: false);
                if (_indexByPath.TryGetValue(result.Path, out var idx))
                {
                    _results.RemoveAt(idx);
                    RebuildIndex();
                    _flatOrderDirty = true;
                }
            }
            catch (Exception e)
            {
                _failures.Add((result.Path, e.Message));
            }
        }
    }

    private void RebuildIndex()
    {
        _indexByPath.Clear();
        for (int i = 0; i < _results.Count; i++) _indexByPath[_results[i].Path] = i;
    }

    private IEnumerable<Section> VisibleSections()
    {
        switch (_viewMode)
        {
            case ViewMode.Grouped:
                foreach (var group in _duplicateGroups)
                {
                    var indices = group.Where(_indexByPath.ContainsKey).Select(p => _indexByPath[p]).ToList();
                    yield return new Section($"Group ({indices.Count})", indices);
                }
                break;
            case ViewMode.Pipeline:
                if (_pipelineResult is { } pr)
                {
                    yield return new Section(null, pr.Shortlist);
                }
                break;
            default:
                yield return new Section(null, FlatOrder());
                break;
        }
    }

    private List<int>? _flatOrderCache;
    private bool _flatOrderDirty = true;

    /// <summary>
    /// The Flat view's photo order (by raw sharpness, best first), cached
    /// and only recomputed when the underlying data actually changes --
    /// re-sorting all N results on every single render (Blazor calls the
    /// markup's @foreach source on every re-render) turned a 1000+ photo
    /// scan into an O(n^2 log n) render loop that looked like a hang.
    /// </summary>
    private List<int> FlatOrder()
    {
        if (_flatOrderDirty || _flatOrderCache is null)
        {
            _flatOrderCache = _sortBy == SortBy.Overall
                ? Enumerable.Range(0, _results.Count).OrderByDescending(i => Ranking.OverallScore(_results[i].Metrics, _weights)).ToList()
                : Enumerable.Range(0, _results.Count).OrderByDescending(i => _results[i].Score).ToList();
            _flatOrderDirty = false;
        }
        return _flatOrderCache;
    }

    private async Task OnModeChanged(int index, ChangeEventArgs e)
    {
        if (!Enum.TryParse<PhotoMode>(e.Value?.ToString(), out var mode)) return;

        var old = _results[index];
        var channel = Channel.CreateUnbounded<RecomputeEvent>();
        var items = new List<(string Path, PhotoMode Mode)> { (old.Path, mode) };
        _ = Task.Run(() => Scan.RunRecomputeAsync(items, channel.Writer));

        await foreach (var evt in channel.Reader.ReadAllAsync())
        {
            if (evt is RecomputeEvent.Result r && _indexByPath.TryGetValue(r.Value.Path, out var idx))
            {
                var current = _results[idx];
                _results[idx] = current with { Mode = mode, Score = r.Value.Score, Metrics = r.Value.Metrics };
                _flatOrderDirty = true;
                StateHasChanged();
            }
        }
    }

    private static string SharpnessBadgeClass(double raw) =>
        raw <= SharpnessBlurryMax ? "badge-blurry" : raw <= SharpnessSoftMax ? "badge-soft" : "badge-sharp";

    private readonly Dictionary<string, string> _thumbCache = [];

    private string ThumbDataUri(PhotoResult result)
    {
        if (_thumbCache.TryGetValue(result.Path, out var cached)) return cached;
        var base64 = Convert.ToBase64String(result.EncodeThumbPng());
        var uri = $"data:image/png;base64,{base64}";
        _thumbCache[result.Path] = uri;
        return uri;
    }

    /// <summary>
    /// The image cap for the double-click "full size" preview -- not the
    /// true original resolution (which could be 40-100MP and slow/wasteful
    /// to decode just to fit it on screen), big enough to judge focus at
    /// full-window size. Matches app.rs's PREVIEW_MAX_DIM.
    /// </summary>
    private const int PreviewMaxDim = 2400;

    private string? _viewerPath;
    private string? _viewerDataUri;
    private bool _viewerNeedsFocus;
    private ElementReference _viewerOverlayRef;
    private CancellationTokenSource? _viewerCts;

    private async Task OpenPreview(string path)
    {
        _viewerCts?.Cancel();
        var cts = new CancellationTokenSource();
        _viewerCts = cts;

        _viewerPath = path;
        _viewerDataUri = null;
        _viewerNeedsFocus = true;

        string? dataUri;
        try
        {
            dataUri = await Task.Run(() =>
            {
                try
                {
                    var img = Photo.DecodePhoto(path, PreviewMaxDim);
                    var png = SkiaImageCodec.EncodePng(img);
                    return $"data:image/png;base64,{Convert.ToBase64String(png)}";
                }
                catch
                {
                    return null;
                }
            }, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || _viewerPath != path)
        {
            return; // superseded by a newer preview or closed while decoding
        }

        if (dataUri is null)
        {
            // Matches app.rs's PreviewEvent::Failed handling: a failed
            // decode just closes the viewer rather than showing an error.
            _viewerPath = null;
        }
        else
        {
            _viewerDataUri = dataUri;
        }
        StateHasChanged();
    }

    private void CloseViewer()
    {
        _viewerCts?.Cancel();
        _viewerPath = null;
        _viewerDataUri = null;
    }

    private void OnViewerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseViewer();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_viewerNeedsFocus && _viewerPath is not null)
        {
            _viewerNeedsFocus = false;
            try
            {
                await _viewerOverlayRef.FocusAsync();
            }
            catch
            {
                // Best-effort -- the close button and click-outside still work without focus.
            }
        }
    }

    public void Dispose()
    {
        _scanCts?.Cancel();
        _viewerCts?.Cancel();
    }
}
